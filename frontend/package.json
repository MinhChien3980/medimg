{
  "name": "medimg-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "lint": "node node_modules/eslint/bin/eslint.js . && node node_modules/prettier/bin/prettier.cjs --check .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "typecheck": "node node_modules/typescript/bin/tsc -b --noEmit",
    "test": "node node_modules/vitest/vitest.mjs",
    "e2e": "node node_modules/@playwright/test/cli.js test",
    "e2e:install": "node node_modules/@playwright/test/cli.js install chromium"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@cornerstonejs/core": "5.19.6",
    "@cornerstonejs/metadata": "5.19.6",
    "@cornerstonejs/nifti-volume-loader": "5.19.6",
    "@cornerstonejs/tools": "5.19.6",
    "@cornerstonejs/utils": "5.19.6",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "^5.108.4",
    "antd": "^6.7.2",
    "axios": "^1.21.1",
    "events": "3.3.0",
    "i18next": "^27.2.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2",
    "three": "0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
